              <div class="ai-import-actions">
                <button type="button" id="discord-notification-save">設定を保存</button>
                <button type="button" class="secondary" id="discord-notification-test">接続テスト</button>
                <button type="button" class="secondary" id="discord-notification-send">ランダム通知を今すぐ送る</button>
              </div>
              <p class="discord-notification-status" id="discord-notification-status" role="status" aria-live="polite"></p>
            </section>
            <form method="post" action="/reset" class="reset-form"><button type="submit" class="danger-button">全てリセット</button></form>
            <section class="data-transfer-panel" id="data-transfer-panel" hidden aria-labelledby="data-transfer-heading">
              <h3 id="data-transfer-heading">端末内データ</h3>
              <p class="small">バックアップJSONをダウンロードできます。キャッシュやサイトデータを消す前に必ず保存してください。</p>
              <div class="data-transfer-actions">
                <button type="button" id="static-data-export">バックアップを保存</button>
                <label>バックアップから復元<input type="file" id="static-data-import" accept="application/json" /></label>
                <button type="button" class="secondary" id="static-data-import-button">取り込む</button>
